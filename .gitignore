# ============================================================
#  AWOS Bank — .gitignore (Java / Spring Boot / Maven)
# ============================================================

# ---------- Java / JVM ----------
*.class
*.log
*.ctxt
*.jfr
hs_err_pid*
replay_pid*
.classpath
.project
.settings/
.metadata/

# ---------- Maven ----------
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar
.mvn/wrapper/maven-wrapper.properties

# ---------- Gradle (caso migre no futuro) ----------
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/

# ---------- IDE — IntelliJ IDEA ----------
.idea/
*.iml
*.ipr
*.iws
out/
.idea_modules/

# ---------- IDE — Eclipse ----------
bin/
tmp/
*.tmp
*.bak
*.swp
*~.nib
local.properties

# ---------- IDE — VS Code ----------
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ---------- IDE — NetBeans ----------
nbproject/private/
nbbuild/
dist/
nbdist/
.nb-gradle/

# ---------- Spring Boot ----------
# Arquivos gerados no /target já cobertos acima
*.jar
*.war
*.ear
*.nar

# ---------- Logs ----------
logs/
*.log
log/
spring.log

# ---------- Banco de dados (arquivos locais) ----------
*.db
*.mv.db
*.trace.db
*.h2.db
data/
h2/

# ---------- Segredos / Configurações locais ----------
# NUNCA commitar credenciais
application-local.yml
application-local.properties
application-dev-local.yml
.env
.env.*
!.env.example
*.pem
*.key
secrets/
secrets.yml

# ---------- Sistema Operacional ----------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---------- Docker / Containers ----------
.docker/
docker-compose.override.yml

# ---------- Node / Frontend (se adicionar build tooling) ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# ---------- Caches e temporários ----------
.cache/
.tmp/
temp/
*.pid
*.seed

# ---------- Sonar / Coverage ----------
.sonar/
.scannerwork/
coverage/
*.exec
*.jacoco*

# ---------- Documentação gerada ----------
site/
docs/_build/
javadoc/

# ---------- Arquivos compactados e backups ----------
*.zip
*.tar
*.tar.gz
*.rar
*.bak
*.orig
*.rej

# ---------- Thymeleaf / Build do front ----------
src/main/resources/static/built/
src/main/resources/static/dist/