# Copie para ".env" e ajuste. O arquivo .env NÃO deve ser commitado (está no .gitignore).

# --- Banco de dados (PostgreSQL) ---
DB_NAME=awosbank
DB_USERNAME=awosbank
DB_PASSWORD=troque-esta-senha
DB_PORT=5432

# --- Aplicação ---
APP_PORT=8080
# dev  = usuário de demonstração + Swagger + cookies sem Secure (http://localhost)
# prod = cookie Secure (exige HTTPS), sem Swagger, sem dados de demonstração
SPRING_PROFILES_ACTIVE=dev
# Atrás de proxy reverso / load balancer: "framework" (registra o IP real do cliente na auditoria)
FORWARD_HEADERS_STRATEGY=none
# Imagem publicada pelo pipeline (opcional): ghcr.io/<usuario>/awosbank:latest
# APP_IMAGE=awosbank-api:local

# =====================================================================
# Deploy no Vercel (Container Runtime) — configure em Project Settings > Environment Variables
# =====================================================================
# PORT=8080                                  # obrigatório: o padrão do Vercel é 80 e a imagem roda sem root
# SPRING_PROFILES_ACTIVE=prod
# DB_URL=jdbc:postgresql://<host>/<db>?sslmode=require   # ex.: Neon (use o host "pooler")
# DB_USERNAME=...
# DB_PASSWORD=...
# FORWARD_HEADERS_STRATEGY=framework         # já é o padrão no perfil prod
# DB_POOL_MAX=5
