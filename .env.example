# Copie para ".env" e ajuste. O arquivo .env NÃO deve ser commitado (está no .gitignore).

# --- Banco de dados (PostgreSQL) ---
DB_NAME=awosbank
DB_USERNAME=awosbank
DB_PASSWORD=troque-esta-senha
DB_PORT=5432

# --- Aplicação ---
APP_PORT=8080
# dev  = usuário de demonstração + Swagger + cookies sem Secure (http://localhost)
# prod = cookie Secure (exige HTTPS), sem Swagger, sem dados de demonstração
SPRING_PROFILES_ACTIVE=dev
# Atrás de proxy reverso / load balancer: "framework" (registra o IP real do cliente na auditoria)
FORWARD_HEADERS_STRATEGY=none
# Imagem publicada pelo pipeline (opcional): ghcr.io/<usuario>/awosbank:latest
# APP_IMAGE=awosbank-api:local
